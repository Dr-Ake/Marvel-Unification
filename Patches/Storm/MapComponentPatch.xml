<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/MapDef[defName="Base"]/components</xpath>
    <success>Always</success>
    <match Class="PatchOperationAdd">
      <xpath>/Defs/MapDef[defName="Base"]/components</xpath>
      <value>
        <li Class="Rimworld_Storm.StormGodComponent" />
      </value>
    </match>
    <nomatch Class="PatchOperationAdd">
      <xpath>/Defs/MapDef[defName="Base"]</xpath>
      <value>
        <components>
          <li Class="Rimworld_Storm.StormGodComponent" />
        </components>
      </value>
    </nomatch>
  </Operation>
</Patch>
