<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef>
    <defName>Gambit_Injector</defName>
    <label>Gambit injector</label>
    <description>A single-use injector that infuses a pawn with volatile psionic charge, unlocking the full Gambit x-gene.</description>
    <thingClass>ThingWithComps</thingClass>
    <category>Item</category>
    <techLevel>Spacer</techLevel>
    <tradeability>All</tradeability>
    <tradeTags>
      <li>ExoticMisc</li>
      <li>TechSpecialty</li>
    </tradeTags>
    <thingCategories>
      <li>Artifacts</li>
    </thingCategories>
    <stackLimit>1</stackLimit>
    <selectable>true</selectable>
    <useHitPoints>false</useHitPoints>
    <graphicData>
      <texPath>Things/Gambit/GambitInjector</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <statBases>
      <MarketValue>3500</MarketValue>
      <Mass>0.2</Mass>
      <Flammability>0</Flammability>
      <Beauty>0</Beauty>
      <MaxHitPoints>50</MaxHitPoints>
    </statBases>
    <altitudeLayer>Item</altitudeLayer>
    <drawGUIOverlay>true</drawGUIOverlay>
    <alwaysHaulable>true</alwaysHaulable>
    <comps>
      <li Class="CompProperties_Forbiddable" />
      <li Class="CompProperties_Usable">
        <useLabel>inject</useLabel>
      </li>
      <li Class="GambitXGene.Comps.CompProperties_UseEffectGiveHediff">
        <hediffDef>Gambit_XGene_Hediff</hediffDef>
      </li>
      <li Class="CompProperties_UseEffectDestroySelf" />
    </comps>
  </ThingDef>

  <ThingDef>
    <defName>Unfinished_GambitInjector</defName>
    <label>unfinished Gambit injector</label>
    <thingClass>UnfinishedThing</thingClass>
    <category>Item</category>
    <selectable>true</selectable>
    <altitudeLayer>Item</altitudeLayer>
    <drawGUIOverlay>true</drawGUIOverlay>
    <useHitPoints>false</useHitPoints>
    <stackLimit>1</stackLimit>
    <thingCategories>
      <li>Unfinished</li>
    </thingCategories>
    <graphicData>
      <texPath>Things/Item/Unfinished/UnfinishedComponent</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
  </ThingDef>
</Defs>
