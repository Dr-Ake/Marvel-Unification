<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef>
    <defName>Storm_GeneInjector</defName>
    <label>Storm gene injector</label>
    <description>A single-use injector that permanently grants the Storm Gene. Difficult to fabricate, but grants powerful weather-controlling abilities.</description>
    <thingClass>ThingWithComps</thingClass>
    <category>Item</category>
    <techLevel>Spacer</techLevel>
    <tradeability>All</tradeability>
    <tradeTags>
      <li>ExoticMisc</li>
      <li>TechSpecialty</li>
    </tradeTags>
    <thingCategories>
      <li>Artifacts</li>
    </thingCategories>
    <stackLimit>1</stackLimit>
    <selectable>true</selectable>
    <useHitPoints>false</useHitPoints>
    <graphicData>
      <texPath>Things/Item/Storm/StormGeneInjector</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <statBases>
      <MarketValue>3500</MarketValue>
      <Mass>0.2</Mass>
      <Flammability>0</Flammability>
      <Beauty>0</Beauty>
      <MaxHitPoints>50</MaxHitPoints>
    </statBases>
    <altitudeLayer>Item</altitudeLayer>
    <drawGUIOverlay>true</drawGUIOverlay>
    <alwaysHaulable>true</alwaysHaulable>
    
    <!-- Ingestible properties to simulate injection -->
    <ingestible>
      <foodType>Processed</foodType>
      <preferability>NeverForNutrition</preferability>
      <baseIngestTicks>100</baseIngestTicks>
      <ingestSound>Ingest_Inject</ingestSound>
      <ingestHoldOffsetStanding>
        <northDefault>
          <offset>(0.18,0,0)</offset>
        </northDefault>
      </ingestHoldOffsetStanding>
      <ingestCommandString>Inject {0}</ingestCommandString>
      <ingestReportString>Injecting {0}.</ingestReportString>
      <chairSearchRadius>0</chairSearchRadius>
      <outcomeDoers>
        <li Class="IngestionOutcomeDoer_GiveHediff">
          <hediffDef>Storm_Gene</hediffDef>
          <severity>1.0</severity>
        </li>
      </outcomeDoers>
    </ingestible>
    
    <comps>
      <li Class="CompProperties_Forbiddable" />
    </comps>
  </ThingDef>
</Defs>
