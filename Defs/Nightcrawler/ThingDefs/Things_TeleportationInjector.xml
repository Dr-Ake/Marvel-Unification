<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef>
    <defName>Nightcrawler_TeleportationInjector</defName>
    <label>teleportation injector</label>
    <description>A single-use injector that permanently teaches the BAMF!! teleportation toggle to the recipient.</description>
    <thingClass>ThingWithComps</thingClass>
    <category>Item</category>
    <techLevel>Spacer</techLevel>
    <tradeability>All</tradeability>
    <tradeTags>
      <li>ExoticMisc</li>
      <li>TechSpecialty</li>
    </tradeTags>
    <thingCategories>
      <li>Artifacts</li>
    </thingCategories>
    <stackLimit>1</stackLimit>
    <selectable>true</selectable>
    <useHitPoints>false</useHitPoints>
    <graphicData>
      <texPath>Things/Item/Nightcrawler/TeleportationInjector</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <statBases>
      <MarketValue>3500</MarketValue>
      <Mass>0.2</Mass>
      <Flammability>0</Flammability>
      <Beauty>0</Beauty>
      <MaxHitPoints>50</MaxHitPoints>
    </statBases>
    <altitudeLayer>Item</altitudeLayer>
    <drawGUIOverlay>true</drawGUIOverlay>
    <alwaysHaulable>true</alwaysHaulable>
    <comps>
      <li Class="CompProperties_Forbiddable" />
      <li Class="CompProperties_Usable">
        <useLabel>inject</useLabel>
      </li>
      <li Class="NightcrawlerTeleportation.CompProperties_UseEffectGiveTeleportHediff">
        <hediffDef>Nightcrawler_Teleportation</hediffDef>
        <severity>1.0</severity>
      </li>
      <li Class="CompProperties_UseEffectDestroySelf" />
    </comps>
  </ThingDef>

  <ThingDef>
    <defName>Unfinished_TeleportationInjector</defName>
    <label>unfinished teleportation injector</label>
    <thingClass>UnfinishedThing</thingClass>
    <category>Item</category>
    <selectable>true</selectable>
    <altitudeLayer>Item</altitudeLayer>
    <drawGUIOverlay>true</drawGUIOverlay>
    <useHitPoints>false</useHitPoints>
    <stackLimit>1</stackLimit>
    <thingCategories>
      <li>Unfinished</li>
    </thingCategories>
    <graphicData>
      <texPath>Things/Item/Unfinished/UnfinishedComponent</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
  </ThingDef>
</Defs>
