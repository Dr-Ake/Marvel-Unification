<Defs>
  <ThingDef>
    <defName>MM_MultipleManInjector</defName>
    <label>Multiple Man Gene Injector</label>
    <description>A single-use injector that permanently grants the Multiple Man gene, allowing a pawn to spawn temporary dupes.</description>
    <thingClass>ThingWithComps</thingClass>
    <category>Item</category>
    <techLevel>Spacer</techLevel>
    <tradeability>All</tradeability>
    <tradeTags>
      <li>ExoticMisc</li>
      <li>TechSpecialty</li>
    </tradeTags>
    <thingCategories>
      <li>Artifacts</li>
    </thingCategories>
    <stackLimit>1</stackLimit>
    <selectable>true</selectable>
    <useHitPoints>false</useHitPoints>
    <graphicData>
      <texPath>Things/Item/MultipleMan/MultipleManInjector</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <statBases>
      <MarketValue>3500</MarketValue>
      <Mass>0.2</Mass>
      <Flammability>0</Flammability>
      <Beauty>0</Beauty>
      <MaxHitPoints>50</MaxHitPoints>
    </statBases>
    <altitudeLayer>Item</altitudeLayer>
    <drawGUIOverlay>true</drawGUIOverlay>
    <alwaysHaulable>true</alwaysHaulable>
    <comps>
      <li Class="CompProperties_Forbiddable" />
      <li Class="CompProperties_Usable">
        <useLabel>Inject</useLabel>
      </li>
      <li Class="MultipleManXGene.CompProperties_UseEffectMultipleManGene" />
      <li Class="CompProperties_UseEffectDestroySelf" />
    </comps>
  </ThingDef>

  <ThingDef>
    <defName>Unfinished_MultipleManInjector</defName>
    <label>unfinished multiple man injector</label>
    <thingClass>UnfinishedThing</thingClass>
    <category>Item</category>
    <selectable>true</selectable>
    <altitudeLayer>Item</altitudeLayer>
    <drawGUIOverlay>true</drawGUIOverlay>
    <useHitPoints>false</useHitPoints>
    <stackLimit>1</stackLimit>
    <thingCategories>
      <li>Unfinished</li>
    </thingCategories>
    <graphicData>
      <texPath>Things/Item/Unfinished/UnfinishedComponent</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
  </ThingDef>
</Defs>
